# ProofLens local configuration.
# Copy this file to .env in the repository root. Do not put real secrets in it.
# The values below are local development placeholders.

APP_NAME=ProofLens
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL. Create this database locally, then start the API.
# The password here is only a local placeholder.
DATABASE_URL=postgresql+psycopg://prooflens:prooflens@localhost:5432/prooflens

# Optional. The frontend already defaults to http://localhost:8000.
# Next.js reads environment files from frontend/, not from this root file.
# To override the API URL, create frontend/.env.local with:
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Model. Leave the key empty until you want a live research run.
# OPENAI_MODEL can be changed without editing code. OPENAI_BASE_URL is optional.
# Set true on a hosted copy. Visitors then send their own keys from Settings,
# and the OPENAI_API_KEY and SEARCH_API_KEY below are never used for them.
REQUIRE_USER_KEYS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# Approximate USD per million tokens, used only for the run cost estimate.
PROMPT_PRICE_PER_MILLION=0.15
COMPLETION_PRICE_PER_MILLION=0.60
# A run stops, without another model retry, when the estimate passes this amount.
MAX_RUN_COST_USD=1.0
# New research starts. Reviews of a run that is already waiting are not counted here.
MAX_CONCURRENT_RUNS=3
MAX_RUN_STARTS=40
RUN_START_WINDOW_SECONDS=600

# Web search. The current provider is Tavily.
# Create a key at https://tavily.com and paste it here. Do not commit the real key.
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Embeddings are separate from the chat model. fastembed downloads
# BAAI/bge-small-en-v1.5 on first use. Set EMBEDDING_PROVIDER=hash to skip that.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant. Leave QDRANT_URL empty to store vectors in .qdrant on this machine.
# Set QDRANT_URL to point at a running Qdrant service instead.
QDRANT_URL=
QDRANT_PATH=
QDRANT_COLLECTION=prooflens_evidence
